# Copy to .env and adjust. docker-compose reads this automatically.

# Bearer token guarding the management API and dashboard. Leave empty only for
# local use; set a strong value for any shared deployment.
WHOOK_ADMIN_TOKEN=

# Passphrase used to encrypt provider signing secrets at rest. Required before a
# source can store a signing secret. Keep it stable; rotating it invalidates
# existing sealed secrets.
WHOOK_SECRET_KEY=

# Number of concurrent delivery workers.
WHOOK_WORKERS=4

# Retention. Delete received events older than this (Go duration, e.g. 720h for
# 30 days). Empty disables pruning so nothing is ever deleted automatically.
WHOOK_RETENTION_AGE=
# Keep rejected and dead-lettered events longer for debugging. Defaults to
# WHOOK_RETENTION_AGE when empty.
WHOOK_FAILED_RETENTION_AGE=
